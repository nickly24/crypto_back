DB_NAME=crypto

# Flask backend
BACKEND_SECRET_KEY=dev-backend-secret-change-me

# CORS
FRONTEND_ORIGIN=http://localhost:3000
# true — разрешить любой домен в CORS; false — только FRONTEND_ORIGIN и встроенный список в app.py
