# JWT
JWT_TTL_SECONDS=86400

# Bot gateway mode: local (monolith) or http (legacy manager service)
BOT_GATEWAY_MODE=local
MANAGER_URL="http://127.0.0.1:6800"
MANAGER_SECRET=your-secret-key-here
MANAGER_API_KEY=your-secret-key-here
DB_POOL_SIZE=10
PYTHON_BIN=python3
HEALTH_CHECK_INTERVAL=10
WORKER_HANG_TIMEOUT=60
WORKER_STOP_TIMEOUT=15
MAX_RESTARTS_PER_WINDOW=3
RESTART_WINDOW_SECONDS=300

